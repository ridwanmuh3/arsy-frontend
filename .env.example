# Demo tanpa backend: jawab API dari mock lokal (default aktif).
# Set false jika backend asli sudah tersedia dan bisa diakses publik.
VITE_USE_MOCK=true

# Hanya dipakai saat VITE_USE_MOCK=false.
# Contoh: VITE_API_BASE_URL=https://api-contoh.vercel.app/api/v1
VITE_API_BASE_URL=http://localhost:9000/api/v1
